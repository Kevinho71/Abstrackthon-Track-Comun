# Token del bot (de @BotFather)
TELEGRAM_BOT_TOKEN=

# API key de Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Zona horaria de los agentes (para interpretar "mañana a las 10")
TZ=America/Bogota

# IDs de Telegram permitidos, separados por coma. Vacío = cualquiera puede usar el bot.
ALLOWED_USER_IDS=

# Base de datos. En Railway usa el Volume: /data/app.db
DB_PATH=./data/app.db

# Frecuencia de revisión de recordatorios y enfriamiento entre avisos del mismo chat
REMINDER_INTERVAL_MIN=15
REMINDER_COOLDOWN_MIN=120
