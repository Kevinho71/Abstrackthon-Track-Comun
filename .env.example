# Base de datos. En Railway: la URL de Postgres (base `app`). En local sirve SQLite.
DATABASE_URL=sqlite:///./data/app.db

# Evolution API (en Railway, por la red privada: http://evolution.railway.internal:8080)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Token que Evolution enviará en la URL del webhook. Genera uno largo y aleatorio.
WEBHOOK_TOKEN=
# URL pública del backend y URL con la que Evolution llega al backend (red privada en Railway)
PUBLIC_URL=http://localhost:8000
WEBHOOK_BASE_URL=http://localhost:8000
SESSION_SECRET=

# Telegram (Fase 5)
TELEGRAM_BOT_TOKEN=

# Gemini (Fase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Zona horaria para interpretar "mañana a las 10"
TZ=America/La_Paz

# Minutos de silencio antes de analizar una conversación
SILENCE_MINUTES=10

# Recordatorios (Fase 5)
REMINDER_INTERVAL_MIN=15
REMINDER_COOLDOWN_MIN=120
